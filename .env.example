# PostgreSQL connection string (Railway lo provee automáticamente al vincular el plugin de Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/calume_crm"

# Clave secreta para firmar sesiones de NextAuth (genera una aleatoria: openssl rand -base64 32)
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio-seguro"

# URL pública de la aplicación (Railway la expone como RAILWAY_PUBLIC_DOMAIN)
NEXTAUTH_URL="http://localhost:3000"
